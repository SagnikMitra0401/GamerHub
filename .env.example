# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string, including the database name.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/gaming-hub

# 64 random characters. Never reuse a value from another project.
JWT_SECRET=replace-with-64-random-characters

# ── Media (Cloudinary) ────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Optional integrations ─────────────────────────────────────────────────────
# YouTube Data API v3 key. The gaming bot reports "unconfigured" without it.
YOUTUBE_API_KEY=

# Redis is OFF by default (Upstash free-tier command quota). Set REDIS_ENABLED=1
# and fill both Upstash values to switch the cache and like buffer on.
REDIS_ENABLED=0
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated extra CORS origins. The built-in list covers localhost:3000
# and the deployed Vercel/Render origins.
ALLOWED_ORIGINS=
