# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string, including the database name.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/gaming-hub
# Optional isolated connection for the temporary squad-chat domain.
# MONGO_URI_SQUADS=

# 64 random characters. Never reuse a value from another project.
# At least 32 are enforced at boot, and the example value is refused.
JWT_SECRET=replace-with-64-random-characters

# Public web origin used for CORS and share links. Comma-separated is allowed.
# Required in production: the server refuses to start without it. There is no
# built-in production origin list.
CLIENT_URL=http://localhost:3000
# Extra exact origins (preview domains), never a wildcard.
EXTRA_ALLOWED_ORIGINS=
# Reverse-proxy hop count. Render needs 1.
TRUST_PROXY=1

# Optional hosted error reporting (server-side only, no session replay).
# Leave empty to keep structured JSON logs only. The DSN is a secret.
SENTRY_DSN=

# ── Media (Cloudinary) ────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Prefix for new upload paths: gamerhub/<MEDIA_ENV>/<surface>/<yyyy>/<mm>/…
# Defaults to prod in production and dev everywhere else. Existing assets are
# never moved, so their delivered URLs keep working.
# MEDIA_ENV=dev

# ── Game catalog (optional enrichment) ───────────────────────────────────────
# The catalog works with no key through FreeToGame. IGDB is free and permits
# local caching; create a Twitch application to get these two values.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ── Transactional email (verification + password reset) ──────────────────────
# Free Gmail Apps Script bridge. Works on hosts that block SMTP.
# Follow docs/GMAIL_BRIDGE.md, then paste the deployed /exec URL and secret.
GMAIL_BRIDGE_URL=
GMAIL_BRIDGE_SECRET=
# Optional override: apps-script, console (local) or memory (tests).
# EMAIL_TRANSPORT=apps-script

# Public Google OAuth client id (no client secret is used by the ID-token flow).
GOOGLE_CLIENT_ID=

# ── Optional integrations ─────────────────────────────────────────────────────
# YouTube Data API v3 key. The gaming bot reports "unconfigured" without it.
YOUTUBE_API_KEY=

# Redis is OFF by default (Upstash free-tier command quota). Set REDIS_ENABLED=1
# and fill both Upstash values to switch the cache and like buffer on.
REDIS_ENABLED=0
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only pepper for 8-digit email codes. Required in production; local
# development derives one from JWT_SECRET when it is empty.
# EMAIL_CODE_PEPPER=

# Optional per-surface rate limits (requests per minute). Defaults: search 45,
# catalog 90, admin 120, browse 180, notification engagement 60. With Redis
# enabled, these quotas share counters across instances; the coarse global
# limiter stays local to avoid spending Upstash quota on every request.
# SEARCH_RATE_LIMIT_MAX=45
# CATALOG_RATE_LIMIT_MAX=90
# ADMIN_RATE_LIMIT_MAX=120
# BROWSE_RATE_LIMIT_MAX=180
# NOTIFICATION_ENGAGEMENT_RATE_LIMIT_MAX=60

# Optional restore drill. The target database name must contain drill, restore,
# test or tmp. See docs/BACKUP_RESTORE.md.
# BACKUP_DRILL_URI=
# BACKUP_DRILL_DB=
# BACKUP_DRILL_LIMIT=25
